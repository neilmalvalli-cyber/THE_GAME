{
  "name": "the-game",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "test:landing": "node scripts/landing-check.mjs",
    "test:sql": "bash supabase/tests/run.sh",
    "seed": "node --no-warnings scripts/generate-seed.mjs",
    "test:e2e:supabase": "node scripts/e2e-supabase.mjs",
    "lab": "NEXT_PUBLIC_GAME_BACKEND=mock NEXT_PUBLIC_MOCK_ADMIN_PASSWORD=\"GameAdmin#2026!\" next build && next start",
    "test:perf": "node scripts/perf-check.mjs",
    "lan": "next build && next start -H 0.0.0.0 -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "three": "0.169.0",
    "gsap": "3.12.5",
    "zustand": "4.5.7",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/three": "0.169.0",
    "playwright": "^1.56.1"
  }
}
