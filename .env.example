# ---- which backend the game uses -------------------------------------------------
# supabase = real server (Supabase). mock = everything in the browser (demo/tests only).
NEXT_PUBLIC_GAME_BACKEND=supabase

# ---- Supabase (Project Settings → API) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal e-mail domain for team logins (teams sign in with a name; Supabase needs an e-mail).
# Never mailed. Change only before the first team registers.
TEAM_LOGIN_DOMAIN=teams.thegame.invalid

# ---- mock backend only ---------------------------------------------------------------
# Development-only admin password for the mock backend. Not a real credential.
# NEXT_PUBLIC_MOCK_ADMIN_PASSWORD="GameAdmin#2026!"
